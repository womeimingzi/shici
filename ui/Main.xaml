<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F7F6">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#263E36"/>
      <Setter Property="BorderBrush" Value="#D9E2DD"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#75847D"/><Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Pill" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="#E6F1EB"/><Setter Property="Foreground" Value="#185C45"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#53665D"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Grid.Resources>
  <Grid x:Name="LayoutRoot" Margin="26,22,26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="BrandIcon" Width="36" Height="36" Background="#185C45" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="拾" FontSize="21" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock x:Name="BrandName" Text="拾词" FontSize="25" FontWeight="SemiBold" Foreground="#203A2E" VerticalAlignment="Center"/>
        <TextBlock x:Name="BrandSubtitle" Text=" /  AI 翻译 · 0.3" FontSize="11" Foreground="#809087" VerticalAlignment="Center" Margin="8,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ModeButton" Content="简洁版" ToolTip="切换正常版 / 简洁版；两种模式分别记住大小和位置" Margin="0,0,8,0"/><Button x:Name="SettingsButton" Content="模型设置"/></StackPanel>
    </Grid>
    <Grid x:Name="Hero" Grid.Row="1" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="选中一段，读懂一段。" FontSize="21" FontWeight="SemiBold" Foreground="#263E32"/><TextBlock Text="在 Chrome 或 Zotero 中划选文字，按 Alt + E 即可取词翻译。" FontSize="12" Foreground="#6B7B71" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
      <Border Grid.Column="1" Background="#185C45" CornerRadius="8" Padding="22,12" Margin="14,0,0,0" VerticalAlignment="Top"><TextBlock Text="Alt + E" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15" Foreground="White"/></Border>
    </Grid>
    <Border x:Name="StatusPanel" Grid.Row="2" Background="#EAF0EC" CornerRadius="8" Padding="13,10" Margin="0,0,0,16">
      <StackPanel><TextBlock x:Name="StatusText" Text="准备好了  ·  支持可正常选择、复制的文字" Foreground="#476452" FontSize="12" TextWrapping="Wrap"/><Button x:Name="RetryHotkeyButton" Content="重新注册快捷键" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel>
    </Border>
    <Border Grid.Row="3" Background="White" BorderBrush="#DCE4DE" BorderThickness="1" CornerRadius="11">
      <Grid x:Name="TextPanel" Margin="18,14,18,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><RadioButton x:Name="TranslationTab" Content="译文" GroupName="View" IsChecked="True"/><RadioButton x:Name="OriginalTab" Content="原始文本" GroupName="View" Margin="4,0,0,0"/><RadioButton x:Name="PreviewTab" Content="整理预览" GroupName="View" Margin="4,0,0,0"/></StackPanel><TextBlock x:Name="CountText" Text="等待取词" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8A978E" FontSize="11"/></Grid>
        <Grid Grid.Row="1">
          <TextBox x:Name="RawText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Foreground="#2D3F35" FontFamily="Microsoft YaHei UI" FontSize="15" Padding="2,10,10,10" SelectionBrush="#ACD7BD"/>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="20">
            <Border x:Name="EmptyIcon" Width="48" Height="48" CornerRadius="14" Background="#F0F5F1" HorizontalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="Aa" FontFamily="Georgia" FontSize="24" Foreground="#71927C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="EmptyTitle" Text="先去划选一段文字" FontSize="17" Foreground="#526B5B" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyDescription" Text="首次使用，请在右上角设置模型与 API Key。" FontSize="12" Foreground="#8A978D" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyFootnote" Text="原文始终保留，可随时切换核对。" FontSize="12" Foreground="#8A978D" Margin="0,5,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="SourceText" Grid.Row="2" Text="仅翻译选中的内容，不保存原文与译文历史。" Foreground="#87948B" FontSize="11" Margin="2,10,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>
    <StackPanel x:Name="DetailNotes" Grid.Row="4" Margin="0,11,0,8">
      <TextBlock x:Name="PreviewNote" Text="译文流式显示；重复选区优先使用本次会话的缓存。" Foreground="#7C8B80" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock x:Name="ClipboardText" Text="" Foreground="#7C8B80" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="5">
      <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
        <CheckBox x:Name="FixedPosition" Content="固定位置" FontSize="11" ToolTip="勾选后快捷键不再把窗口移到鼠标旁。仍可拖动标题栏，新的位置会自动记住。" Margin="0,0,18,0"/>
        <CheckBox x:Name="PinWindow" Content="窗口置顶" FontSize="11" ToolTip="保持在其他窗口上方，不影响固定位置。"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="PasteButton" Content="粘贴原文" ToolTip="自动取词失败时，先在原页面按 Ctrl+C，再点这里。核对后点击翻译。" Margin="0,0,8,0"/><Button x:Name="TranslateButton" Content="翻译" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="CopyButton" Content="复制译文" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="HideButton" Content="收起到托盘" Background="#185C45" BorderBrush="#185C45" Foreground="White"/></StackPanel>
    </StackPanel>
  </Grid>
</Grid>
